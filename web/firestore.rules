rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function validListingData(data) {
      return data.keys().hasOnly(
        ['title', 'description', 'price', 'category', 'condition',
         'location', 'imageUrl', 'sellerId', 'sellerEmail', 'sellerName', 'createdAt']
      )
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 2000
        && data.price is number
        && data.price >= 0
        && data.category is string
        && data.category in ['electronics', 'furniture', 'books', 'clothing', 'home', 'other']
        && data.condition is string
        && data.condition in ['New', 'Like New', 'Excellent', 'Very Good', 'Good', 'Fair', 'Poor']
        && data.location is string
        && data.location.size() >= 1
        && data.location.size() <= 100
        && data.imageUrl is string
        && data.imageUrl.size() >= 1
        && data.imageUrl.size() <= 2048
        && (data.imageUrl.matches('https://res\\.cloudinary\\.com/.+')
          || data.imageUrl.matches('https://firebasestorage\\.googleapis\\.com/.+'))
        && data.sellerId is string
        && data.sellerId == request.auth.uid
        && data.sellerEmail is string
        && data.sellerEmail.size() >= 3
        && data.sellerEmail.size() <= 320
        && data.sellerEmail.matches('.*@.*')
        && data.sellerName is string
        && data.sellerName.size() >= 1
        && data.sellerName.size() <= 100
        && data.createdAt == request.time;
    }

    match /listings/{listingId} {
      allow get, list: if true;

      allow create: if request.auth != null
        && validListingData(request.resource.data);

      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validListingData(request.resource.data);

      allow delete: if request.auth != null
        && resource.data.sellerId == request.auth.uid;

      match /reviews/{reviewId} {
        allow get, list: if true;

        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() < 1000;

        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }

    match /favorites/{favId} {
      allow read: if request.auth != null
        && favId.matches(request.auth.uid + "_.*");

      allow create: if request.auth != null
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.listingId is string;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /listingViews/{viewId} {
      allow read: if true;
      allow create, update: if request.resource.data.count is int && request.resource.data.count >= 1;
    }
  }
}
